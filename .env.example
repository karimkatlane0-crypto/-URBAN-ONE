# URBAN ONE backend provider configuration
# Copy to .env locally or configure these values in the deployment secret store.
# Never commit real credentials.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Pole Position staged backend. Disabled by default. Server-only values.
POLE_STAGING_ENABLED=false
POLE_DB_PATH=
POLE_STAGING_ACTORS_JSON=
# Optional Stripe TEST checkout. Never place sk_live keys in this adapter or mobile assets.
POLE_TEST_CHECKOUT_ENABLED=false
POLE_STRIPE_TEST_SECRET_KEY=
POLE_STRIPE_TEST_VISIT_PRICE_ID=
POLE_STRIPE_TEST_SUBSCRIPTION_PRICE_ID=
POLE_CHECKOUT_SUCCESS_URL=
POLE_CHECKOUT_CANCEL_URL=
# External DBRELAY is not integrated; no endpoint is configured.
