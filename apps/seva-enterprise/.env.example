# Production requires HTTPS, persistent filesystem or durable database, real secrets and verification
NODE_ENV=development
PORT=3000
SEVA_DB_PATH=./data/seva.sqlite
SEVA_PUBLIC_URL=https://your-seva-domain.example
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
SEVA_ADMIN_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Create + verify a distinct recurring €50/month product in Stripe TEST before using this value.
# Legacy €500/year price is intentionally NOT accepted by monthly Checkout.
SEVA_MONTHLY_PRICE_ID=
# Keep false until webhook→entitlement→customer login is independently proven
SEVA_SALES_ENABLED=false
# No automatic rewards/payouts; agreement and provider authorization required